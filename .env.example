# Copy to .env.local (frontends) / services/api/.env (API). Never commit real keys.
# LLM: Grok primary (XAI_API_KEY), Claude Agent SDK fallback on a Pro login (CLAUDE_CONFIG_DIR). No Anthropic API key needed.
XAI_API_KEY=
# Absolute path: .env loaders do not expand ~
CLAUDE_CONFIG_DIR=/Users/you/.claude-nextmove
SERPAPI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8000
# "disabled" switches the apps from MSW mocks to the real API
NEXT_PUBLIC_API_MOCKING=enabled
