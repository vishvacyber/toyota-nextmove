# Copy to .env.local (frontends) / services/api/.env (API). Never commit real keys.
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8000
# "disabled" switches the apps from MSW mocks to the real API
NEXT_PUBLIC_API_MOCKING=enabled
