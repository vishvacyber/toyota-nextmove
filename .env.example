# Copy to .env.local (frontends) / services/api/.env (API). Never commit real keys.
# LLM: Gemini is primary (GEMINI_API_KEY, from aistudio.google.com/apikey); the Claude Agent SDK on a separate
# subscription login (CLAUDE_CONFIG_DIR) is the backup.
GEMINI_API_KEY=
GEMINI_MODEL=
# Voice calls: Gemini Live (agent) and Gemini TTS (the rep's voice). Empty = the defaults in agents/live.py.
GEMINI_LIVE_MODEL=
GEMINI_TTS_MODEL=
# Absolute path: .env loaders do not expand ~
CLAUDE_CONFIG_DIR=/Users/you/.claude-nextmove
SERPAPI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8000
# "enabled" = all mocks; "disabled" = real API only; or a comma list of path prefixes to keep mocked, e.g. /kpis,/fairness
NEXT_PUBLIC_API_MOCKING=disabled
# Public customer-app URL for the kiosk's continue-on-phone and take-home QR codes (a phone can't open localhost).
# Production: https://app.toyotanxt.tech (the kiosk lives at https://toyotanxt.tech). Empty = the kiosk's own address.
NEXT_PUBLIC_PHONE_URL=
